# Database
POSTGRES_USER=budgetix
POSTGRES_PASSWORD=budgetix_pass
POSTGRES_DB=budgetix
DATABASE_URL="postgresql://budgetix:budgetix_pass@localhost:5432/budgetix?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# App
PORT=budgetix_pass
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Email (MailHog for dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@budgetix.app

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100
